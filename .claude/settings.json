{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make skills-check)",
      "Bash(bun test)",
      "Bash(bun x tsc --noEmit)",
      "Bash(git status *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(make agent-matrix)",
      "Bash(bun scripts/agent-matrix.ts)",
      "Bash(bun scripts/agent-matrix.ts *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --force-with-lease*)"
    ]
  }
}
