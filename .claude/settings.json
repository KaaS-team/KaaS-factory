{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just fast)",
      "Bash(go test *)",
      "Bash(git status *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --force-with-lease*)"
    ]
  }
}
