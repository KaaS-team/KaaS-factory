{
  "repo": "KaaS-team/KaaS-factory",
  "base": "main",
  "baselineTag": "baseline",
  "gates": [
    {
      "name": "check",
      "cmd": "make check",
      "required": true,
      "role": "test"
    }
  ],
  "agentCommands": {
    "read": [
      "npm ls",
      "npm ls --all",
      "npm ls --depth *",
      "git ls-tree *"
    ],
    "build": [
      "bun *",
      "bunx *",
      "make *"
    ],
    "verify": [
      "bun *",
      "bunx *",
      "make *"
    ]
  },
  "protectedPaths": [
    ".factory/**",
    ".claude/**",
    ".agents/**",
    ".github/**"
  ],
  "_postEditCommand": "optional: argv run after each build edit, {file} is the path, e.g. [\"bunx\", \"biome\", \"check\", \"--write\", \"--no-errors-on-unmatched\", \"{file}\"]",
  "postEditCommand": [],
  "riskPolicy": {
    "autoApproveLowRisk": true
  },
  "maxOpenFactoryPrs": 3,
  "concurrency": 3,
  "pollIntervalSeconds": 15,
  "tmux": {
    "enabled": false,
    "session": "factory"
  },
  "prRunSummary": true,
  "templateOverrides": [],
  "_workflow": "the steps an issue runs: .factory/workflows/<name>.yml, else the runner's copy of feature-to-pr",
  "workflow": "feature-to-pr",
  "_tracker": "where issues live: github, or {\"kind\": \"http\", \"url\": \"https://tasks.example.com\", \"tokenEnv\": \"TRACKER_TOKEN\"} for Tracker API v1",
  "tracker": {
    "kind": "github"
  },
  "_labels": "optional: the factory's label names to your team's, e.g. {\"factory:ready\": \"ready-for-ai\"}",
  "labels": {},
  "agents": {
    "opus": {
      "preset": "claude",
      "model": "claude-opus-5-5"
    },
    "sonnet": {
      "preset": "claude",
      "model": "claude-sonnet-5-5"
    },
    "haiku": {
      "preset": "claude",
      "model": "claude-haiku-5-5"
    }
  },
  "stages": {
    "triage": "haiku",
    "plan": "opus",
    "build": "sonnet",
    "verify": "sonnet",
    "pr": "haiku",
    "retro": "haiku"
  },
  "routes": {
    "docs": {
      "stages": {
        "build": "haiku"
      }
    }
  },
  "toolchain": "bun",
  "setup": [
    "bun install --frozen-lockfile"
  ]
}
