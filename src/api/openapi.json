                            "enum": [
                              "triage",
                              "plan",
                              "build",
                              "verify",
                              "pr"
                            ]
                          },
                          "status": {
                            "enum": [
                              "running",
                              "needs-info",
                              "awaiting-approval",
                              "verifying",
                              "rejected",
                              "shipped",
                              "failed",
                              "needs-human",
                              "cancelled"
                            ]
                          },
                          "started_at": {
                            "type": "string"
                          },
                          "updated_at": {
                            "type": "string"
                          },
                          "tool_calls": {
                            "type": "integer"
                          },
                          "tokens_in": {
                            "type": "integer"
                          },
                          "tokens_out": {
                            "type": "integer"
                          },
                          "cost_usd": {
                            "type": "number"
                          },
                          "gate_line": {
