#!/usr/bin/env bash
# Stand-in msb for the contract suite: honours -w and runs what follows `--` here, with no VM.
set -u
[[ $1 == rm ]] && exit 0
[[ $1 == run ]] || exit 2
shift
wd=.
while [[ $# -gt 0 && $1 != -- ]]; do
  case $1 in
    -w) wd=$2; shift 2 ;;
    *) shift ;;
  esac
done
shift
export MSB_STAND_IN=1 # lets a test see the command went through msb
cd "$wd" && exec "$@"
