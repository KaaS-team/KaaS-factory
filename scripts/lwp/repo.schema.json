{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo.schema.json",
  "title": "repo.json",
  "description": "A repo's gate, impact map and where each check runs. check-affected.py --audit validates it.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "gate": { "type": "string" },
    "prePush": {
      "description": "A command scripts/lwp/pre-push.sh runs on this machine after the gate passes or is queued on the box, for a push step that needs what the box lacks (secrets, a docker engine).",
      "type": "string"
    },
    "stageGates": {
      "description": "The whole-gate command per stage, used when a staged run escalates to full. A stage not named here falls back to gate.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/stage" },
      "additionalProperties": { "type": "string" }
    },
    "schedule": {
      "description": "Cron (UTC, five fields) per scheduled stage.",
      "type": "object",
      "propertyNames": { "enum": ["nightly"] },
      "additionalProperties": { "type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$" }
    },
    "ci": {
      "type": "object",
      "properties": {
        "runner": {
          "description": "github for public repos (free minutes), ubicloud for private ones.",
          "enum": ["github", "ubicloud"]
        },
        "size": { "type": "string" },
        "timeoutMin": { "type": "integer" }
      },
      "required": ["runner"],
      "additionalProperties": false
    },
    "acceptance": {
      "description": "check-acceptance.py: specs carry AC-n lines; each has a holdout at holdout/<spec stem>/AC-n.*, written before the build.",
      "type": "object",
      "properties": {
        "specs": { "$ref": "#/$defs/globs" },
        "holdout": { "type": "string" },
        "run": { "description": "Runs holdout files, {files} replaced by their paths.", "type": "string" }
      },
      "required": ["specs", "run"],
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "properties": {
        "$comment": { "type": "string" },
        "base": { "type": "string" },
        "full": { "$ref": "#/$defs/globs" },
        "ignore": { "$ref": "#/$defs/globs" },
        "fullAt": { "type": "integer" },
        "fullOnly": { "type": "array", "items": { "type": "string" } },
        "jobs": { "type": "integer" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stage": {
      "description": "stop runs before an agent says done, push on CI before merge, nightly on the schedule. Each stage runs every earlier stage's checks too.",
      "enum": ["stop", "push", "nightly"]
    },
    "globs": { "type": "array", "items": { "type": "string" } },
    "check": {
      "type": "object",
      "properties": {
        "$comment": { "type": "string" },
        "name": { "type": "string" },
        "when": { "$ref": "#/$defs/globs" },
        "run": { "type": "string" },
        "each": { "type": "string" },
        "scoped": { "type": "string" },
        "alone": { "type": "boolean" },
        "covers": { "type": "array", "items": { "type": "string" } },
        "stage": { "$ref": "#/$defs/stage" }
      },
      "required": ["name", "when", "run"],
      "additionalProperties": false
    }
  }
}
