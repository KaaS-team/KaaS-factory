# CI/CD run mode (plan "Run anywhere"). Written by `factory install --ci` as
# `factory.yml.example`, GitHub only runs a workflow whose filename ends in
# .yml/.yaml, so this stays inert on its own. To turn it on:
#   1. rename this file to `.github/workflows/factory.yml`
#   2. add repo secrets FACTORY_GH_TOKEN (fine-grained PAT or GitHub App
#      install token with contents+issues+pull-requests read/write, a plain
#      GITHUB_TOKEN-authored PR never triggers this repo's own CI, which
#      defeats the point) and ANTHROPIC_API_KEY
#   3. set the repo VARIABLE FACTORY_MODE=actions (Settings > Secrets and
#      variables > Actions > Variables). A local watcher may drive the same
#      repo too: issue leases and the spend ledger live on GitHub.
#
# Every action is pinned to a commit SHA, with its tag in a comment: a tag can
# be moved to new code, a SHA cannot (tests/release.test.ts enforces this).
#
# The trust rule matches src/chatops.ts's isTrusted(): OWNER, MEMBER or
# COLLABORATOR only. The `if:` below is a first filter to avoid spending a
# runner-minute on an untrusted event; `factory run` re-derives the same
# check from the issue thread before it does anything (audit finding
# "prompt injection" lesson, a workflow-level check alone is not enough,
# since the comment body itself is attacker-controlled).
name: factory

on:
  issues:
    types: [labeled]
  issue_comment:
    types: [created]
  # A review on a factory PR: the PR resolves to its issue (`--pr`), so a
  # "changes requested" review reaches the loop without waiting for the tick.
  pull_request_review:
    types: [submitted]
  schedule:
    # tick: one poll pass across every factory-owned open issue.
    - cron: "*/30 * * * *"
    # scan: file issues from osv-scanner (any lockfile), once a day.
    - cron: "0 6 * * *"
  workflow_dispatch:
    inputs:
      issue:
        description: "issue number to advance with `factory run` (leave blank for `factory tick`)"
        required: false

env:
  FACTORY_RUNNER_REF: v6.1.0 # pinned KaaS Factory release; bump deliberately
  FACTORY_RUNNER_REPO: KaaS-team/KaaS-factory
  CLAUDE_CODE_VERSION: "2.1.286" # pinned claude, same version the Dockerfile installs
  # Pins for every agent. The "Install agents" step installs the ones named in the repo VARIABLE
  # FACTORY_AGENTS (space separated, default "claude"); add a repo secret for each one's key
  # (docs/agents.md lists them). Cursor is host-only. A key you did not set stays empty.
  CODEX_VERSION: "0.156.1"
  GEMINI_VERSION: "0.61.0"
  OPENCODE_VERSION: "1.18.32"
  PI_VERSION: "0.73.1"
  # scan's dependency scanner, any lockfile; the checksum is the release's linux_amd64 SHA256SUMS line.
  OSV_SCANNER_VERSION: "2.6.0"
  OSV_SCANNER_SHA256: ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
  MASTRACODE_VERSION: "0.42.0"

# One workflow run in flight per issue at a time; a second labeled/comment
# event on the same issue queues behind it instead of racing a second
# Actions runner against the first (claim() is still a real CAS underneath,
# this just avoids burning two runners on the same issue).
concurrency:
  group: factory-${{ github.event.issue.number || github.event.pull_request.number || 'scheduled' }}
  cancel-in-progress: false

jobs:
  run-issue:
    if: |
      vars.FACTORY_MODE == 'actions' && (
        (github.event_name == 'issues' && github.event.label.name == 'factory:ready') ||
        (github.event_name == 'issue_comment' &&
         contains(fromJson('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association)) ||
        (github.event_name == 'pull_request_review' &&
         contains(fromJson('["OWNER","MEMBER","COLLABORATOR"]'), github.event.review.author_association))
      )
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      # Full history: the factory branches from the base and diffs against it.
      - name: Checkout target repo
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      # A placeholder, not a no-op you can skip: `bun ci`/`npm ci` alone is not
      # enough on a fresh Actions runner for a stack other than Bun/Node (a
      # Python repo needs actions/setup-python first, etc). Add whatever this
      # repo's stack needs here, before `factory run` builds and gates on it.
      # `config.setup` in .factory/config.json (e.g. `npm ci`) still runs
      # after this, once per worktree — this step is for the runtime itself.
      - name: Set up your toolchain
        run: echo "no language runtime needed beyond what ubuntu-latest ships, or add a setup step here"

      - name: Checkout KaaS Factory (pinned)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ env.FACTORY_RUNNER_REPO }}
          ref: ${{ env.FACTORY_RUNNER_REF }}
          path: .factory-runner

      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "1.3"

      - run: bun install --frozen-lockfile
        working-directory: .factory-runner

      - name: Install agents
        env:
          AGENTS: ${{ vars.FACTORY_AGENTS || 'claude' }}
        run: |
          for agent in $AGENTS; do
            case "$agent" in
              claude) pkg="@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" ;;
              codex) pkg="@openai/codex@${CODEX_VERSION}" ;;
              gemini) pkg="@google/gemini-cli@${GEMINI_VERSION}" ;;
              opencode) pkg="opencode-ai@${OPENCODE_VERSION}" ;;
              pi) pkg="@mariozechner/pi-coding-agent@${PI_VERSION}" ;;
              mastracode) pkg="mastracode@${MASTRACODE_VERSION}" ;;
              *) echo "unknown agent $agent (cursor is host-only)" >&2; exit 1 ;;
            esac
            npm install -g "$pkg"
          done

      - name: gh auth setup-git
        env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
        run: gh auth setup-git

      - name: factory run
        working-directory: .factory-runner
        env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          ANTHROPIC_AUTH_TOKEN: ${{ secrets.ANTHROPIC_AUTH_TOKEN }}
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          XAI_API_KEY: ${{ secrets.XAI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
          # The PEM from `factory receipt keygen`; without it each PR's receipt says Unsigned.
          FACTORY_RECEIPT_KEY: ${{ secrets.FACTORY_RECEIPT_KEY }}
          # A comment on a PR arrives as an issue event whose number is the PR's.
          ISSUE: ${{ github.event.issue.pull_request == null && github.event.issue.number || '' }}
          PR: ${{ github.event.pull_request.number || (github.event.issue.pull_request != null && github.event.issue.number) || '' }}
        run: |
          if [ -n "$PR" ]; then target="--pr $PR"; else target="--issue $ISSUE"; fi
          bun bin/factory run --repo-dir "$GITHUB_WORKSPACE" $target

      - name: factory park (on failure)
        if: failure()
        working-directory: .factory-runner
        env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
          ISSUE: ${{ github.event.issue.pull_request == null && github.event.issue.number || '' }}
          PR: ${{ github.event.pull_request.number || (github.event.issue.pull_request != null && github.event.issue.number) || '' }}
        run: |
          if [ -n "$PR" ]; then target="--pr $PR"; else target="--issue $ISSUE"; fi
          bun bin/factory park --repo-dir "$GITHUB_WORKSPACE" $target \
            --reason "CI run failed or timed out, see the Actions run for this workflow"

  tick:
    if: vars.FACTORY_MODE == 'actions' && github.event_name == 'schedule' && github.event.schedule == '*/30 * * * *'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      # See run-issue's "Set up your toolchain" step: `factory tick` can also
      # build and gate an issue, so it needs this repo's runtime too.
      - name: Set up your toolchain
        run: echo "no language runtime needed beyond what ubuntu-latest ships, or add a setup step here"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ env.FACTORY_RUNNER_REPO }}
          ref: ${{ env.FACTORY_RUNNER_REF }}
          path: .factory-runner
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "1.3"
      - run: bun install --frozen-lockfile
        working-directory: .factory-runner
      - name: Install agents
        env:
          AGENTS: ${{ vars.FACTORY_AGENTS || 'claude' }}
        run: |
          for agent in $AGENTS; do
            case "$agent" in
              claude) pkg="@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" ;;
              codex) pkg="@openai/codex@${CODEX_VERSION}" ;;
              gemini) pkg="@google/gemini-cli@${GEMINI_VERSION}" ;;
              opencode) pkg="opencode-ai@${OPENCODE_VERSION}" ;;
              pi) pkg="@mariozechner/pi-coding-agent@${PI_VERSION}" ;;
              mastracode) pkg="mastracode@${MASTRACODE_VERSION}" ;;
              *) echo "unknown agent $agent (cursor is host-only)" >&2; exit 1 ;;
            esac
            npm install -g "$pkg"
          done
      - env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
        run: gh auth setup-git
      - name: factory tick
        working-directory: .factory-runner
        env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          ANTHROPIC_AUTH_TOKEN: ${{ secrets.ANTHROPIC_AUTH_TOKEN }}
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          XAI_API_KEY: ${{ secrets.XAI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
        run: bun bin/factory tick --repo-dir "$GITHUB_WORKSPACE"

  scan:
    if: vars.FACTORY_MODE == 'actions' && github.event_name == 'schedule' && github.event.schedule == '0 6 * * *'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ env.FACTORY_RUNNER_REPO }}
          ref: ${{ env.FACTORY_RUNNER_REF }}
          path: .factory-runner
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "1.3"
      - run: bun install --frozen-lockfile
        working-directory: .factory-runner
      - name: Install osv-scanner
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          curl -fsSL -o "$RUNNER_TEMP/bin/osv-scanner" "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64"
          echo "${OSV_SCANNER_SHA256}  $RUNNER_TEMP/bin/osv-scanner" | sha256sum -c -
          chmod +x "$RUNNER_TEMP/bin/osv-scanner"
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - name: factory scan
        working-directory: .factory-runner
        env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
        run: bun bin/factory scan --repo-dir "$GITHUB_WORKSPACE"

  # `workflow_dispatch`: run one issue if `issue` was given, otherwise one
  # tick, the manual escape hatch for "nothing fired and I don't want to
  # wait 30 minutes."
  manual:
    if: vars.FACTORY_MODE == 'actions' && github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      # See run-issue's "Set up your toolchain" step.
      - name: Set up your toolchain
        run: echo "no language runtime needed beyond what ubuntu-latest ships, or add a setup step here"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ env.FACTORY_RUNNER_REPO }}
          ref: ${{ env.FACTORY_RUNNER_REF }}
          path: .factory-runner
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: "1.3"
      - run: bun install --frozen-lockfile
        working-directory: .factory-runner
      - name: Install agents
        env:
          AGENTS: ${{ vars.FACTORY_AGENTS || 'claude' }}
        run: |
          for agent in $AGENTS; do
            case "$agent" in
              claude) pkg="@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" ;;
              codex) pkg="@openai/codex@${CODEX_VERSION}" ;;
              gemini) pkg="@google/gemini-cli@${GEMINI_VERSION}" ;;
              opencode) pkg="opencode-ai@${OPENCODE_VERSION}" ;;
              pi) pkg="@mariozechner/pi-coding-agent@${PI_VERSION}" ;;
              mastracode) pkg="mastracode@${MASTRACODE_VERSION}" ;;
              *) echo "unknown agent $agent (cursor is host-only)" >&2; exit 1 ;;
            esac
            npm install -g "$pkg"
          done
      - env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
        run: gh auth setup-git
      - name: factory run or tick
        working-directory: .factory-runner
        env:
          GH_TOKEN: ${{ secrets.FACTORY_GH_TOKEN }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          ANTHROPIC_AUTH_TOKEN: ${{ secrets.ANTHROPIC_AUTH_TOKEN }}
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          XAI_API_KEY: ${{ secrets.XAI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
          ISSUE: ${{ github.event.inputs.issue }}
        run: |
          if [ -n "$ISSUE" ]; then
            bun bin/factory run --repo-dir "$GITHUB_WORKSPACE" --issue "$ISSUE"
          else
            bun bin/factory tick --repo-dir "$GITHUB_WORKSPACE"
          fi
