[Unit]
Description=KaaS Factory run loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=factory
WorkingDirectory=/srv/factory/repo
# Tokens (GITHUB_TOKEN and the dispatcher's) live in this file, mode 0600, never in the unit.
EnvironmentFile=/etc/factory/env
ExecStart=/usr/local/bin/factory serve --addr 127.0.0.1:8787 --drain 30s
# SIGTERM stops dispatching; the unit waits a little longer than --drain before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/factory
PrivateTmp=true

[Install]
WantedBy=multi-user.target
